// UNDERGROUND_0x1 CTF Platform Database Schema
// Using Neon PostgreSQL with Prisma 7

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & TEAM MODELS
// ============================================

model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String   @unique
  username      String   @unique
  avatarUrl     String?
  
  // Team relationship
  teamId        String?
  team          Team?    @relation(fields: [teamId], references: [id])
  isTeamLeader  Boolean  @default(false)
  
  // Stats
  totalPoints   Int      @default(0)
  solvedCount   Int      @default(0)
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastActive    DateTime @default(now())
  
  // Relations
  submissions   Submission[]
  joinRequests  JoinRequest[]
  feedback      Feedback[]
  achievements  UserAchievement[]
  
  role          Role     @default(USER)

  @@index([clerkId])
  @@index([teamId])
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model Team {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  avatarUrl     String?
  inviteCode    String   @unique @default(cuid())
  
  // Stats
  totalPoints   Int      @default(0)
  solvedCount   Int      @default(0)
  rank          Int?
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  members       User[]
  submissions   Submission[]
  solves        Solve[]
  joinRequests  JoinRequest[]
  certificates  Certificate[]
  
  @@index([totalPoints(sort: Desc)])
}

// ============================================
// CHALLENGE MODELS
// ============================================

model Category {
  id            String      @id @default(cuid())
  name          String      @unique
  slug          String      @unique
  description   String?
  icon          String?
  color         String?
  order         Int         @default(0)
  
  challenges    Challenge[]
  
  @@index([order])
}

model Challenge {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  description   String
  
  // Categorization
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  difficulty    Difficulty  @default(MEDIUM)
  
  // Points
  points        Int
  
  // Flag (hashed)
  flagHash      String
  
  // Files & Resources
  files         ChallengeFile[]
  hints         Hint[]
  resourceUrl   String?         // External link to resources/files
  
  // Solution Write-up (visible after solving)
  writeup       String?         // Markdown content for solution writeup
  writeupUrl    String?         // External URL for writeup (optional)
  
  // Status
  isActive      Boolean     @default(true)
  isHidden      Boolean     @default(false)
  
  // Stats
  solveCount    Int         @default(0)
  attemptCount  Int         @default(0)
  
  // Timestamps
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  releasedAt    DateTime    @default(now())
  
  // Relations
  submissions   Submission[]
  solves        Solve[]
  firstBlood    Solve?      @relation("FirstBlood")
  
  @@index([categoryId])
  @@index([difficulty])
  @@index([isActive, isHidden])
}

model ChallengeFile {
  id            String      @id @default(cuid())
  challengeId   String
  challenge     Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  
  name          String
  url           String
  size          Int
  
  createdAt     DateTime    @default(now())
  
  @@index([challengeId])
}

model Hint {
  id            String      @id @default(cuid())
  challengeId   String
  challenge     Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  
  content       String
  cost          Int         @default(0)
  order         Int         @default(0)
  
  createdAt     DateTime    @default(now())
  
  @@index([challengeId])
}

enum Difficulty {
  MEDIUM
  HARD
  GOD_LEVEL
}

// ============================================
// SUBMISSION & SOLVE MODELS
// ============================================

model Submission {
  id            String      @id @default(cuid())
  
  // Who submitted
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  teamId        String?
  team          Team?       @relation(fields: [teamId], references: [id])
  
  // What was submitted
  challengeId   String
  challenge     Challenge   @relation(fields: [challengeId], references: [id])
  flag          String
  
  // Result
  isCorrect     Boolean
  
  // Metadata
  ipAddress     String?
  userAgent     String?
  
  // Timestamp
  createdAt     DateTime    @default(now())
  
  @@index([userId])
  @@index([teamId])
  @@index([challengeId])
  @@index([createdAt])
}

model Solve {
  id            String      @id @default(cuid())
  
  // Who solved
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id])
  
  // What was solved
  challengeId   String
  challenge     Challenge   @relation(fields: [challengeId], references: [id])
  
  // Points earned
  points        Int
  
  // First blood tracking
  isFirstBlood  Boolean     @default(false)
  firstBloodFor Challenge?  @relation("FirstBlood", fields: [firstBloodId], references: [id])
  firstBloodId  String?     @unique
  
  // Timestamp
  solvedAt      DateTime    @default(now())
  
  @@unique([teamId, challengeId])
  @@index([teamId])
  @@index([challengeId])
  @@index([solvedAt])
}

// ============================================
// ANNOUNCEMENTS
// ============================================

model Announcement {
  id            String      @id @default(cuid())
  title         String
  content       String
  isPinned      Boolean     @default(false)
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@index([isPinned, createdAt])
}

// ============================================
// JOIN REQUEST MODEL
// ============================================

model JoinRequest {
  id            String            @id @default(cuid())
  
  // Who is requesting
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  
  // Which team
  teamId        String
  team          Team              @relation(fields: [teamId], references: [id])
  
  // Status
  status        JoinRequestStatus @default(PENDING)
  
  // Timestamps
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  
  @@unique([userId, teamId])
  @@index([teamId, status])
  @@index([userId])
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ============================================
// FEEDBACK MODEL
// ============================================

model Feedback {
  id            String         @id @default(cuid())
  
  // Who submitted (optional - allow anonymous)
  userId        String?
  user          User?          @relation(fields: [userId], references: [id])
  
  // Feedback content
  subject       String
  message       String
  rating        Int            @default(5)  // 1-5 star rating
  
  // Status for admin tracking
  status        FeedbackStatus @default(NEW)
  adminResponse String?
  
  // Timestamps
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  @@index([status, createdAt])
  @@index([userId])
}

enum FeedbackStatus {
  NEW
  REVIEWED
  RESOLVED
}

// ============================================
// ACHIEVEMENTS SYSTEM
// ============================================

model Achievement {
  id            String              @id @default(cuid())
  
  // Achievement info
  slug          String              @unique
  name          String
  description   String
  icon          String              // Emoji or icon name
  
  // Requirements
  category      AchievementCategory
  requirement   Int                 @default(1)  // e.g., 3 first bloods, 5 solves, etc.
  
  // Rarity
  rarity        AchievementRarity   @default(COMMON)
  
  // Relations
  users         UserAchievement[]
  
  createdAt     DateTime            @default(now())
}

model UserAchievement {
  id            String      @id @default(cuid())
  
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  
  // When earned
  earnedAt      DateTime    @default(now())
  
  // Unique per user per achievement
  @@unique([userId, achievementId])
  @@index([userId])
}

enum AchievementCategory {
  FIRST_BLOOD    // Related to getting first bloods
  SOLVES         // Related to number of solves
  CATEGORY       // Related to completing a category
  DIFFICULTY     // Related to solving certain difficulty
  STREAK         // Related to solving in succession
  SPECIAL        // Special/rare achievements
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

// ============================================
// ACTIVITY LOG (for feed)
// ============================================

model ActivityLog {
  id            String        @id @default(cuid())
  
  // Event type
  type          ActivityType
  
  // Who did it
  teamId        String?
  teamName      String?
  userId        String?
  username      String?
  
  // What happened
  challengeId   String?
  challengeTitle String?
  categoryName  String?
  points        Int?
  
  // Extra data
  isFirstBlood  Boolean       @default(false)
  metadata      String?       // JSON for extra data
  
  createdAt     DateTime      @default(now())
  
  @@index([type, createdAt])
  @@index([teamId])
}

enum ActivityType {
  SOLVE
  FIRST_BLOOD
  TEAM_CREATED
  ACHIEVEMENT_EARNED
}

// ============================================
// PLATFORM SETTINGS (Singleton)
// ============================================

model PlatformSettings {
  id                  String    @id @default("default")
  
  // Registration
  registrationOpen    Boolean   @default(true)
  
  // Submissions
  submissionsEnabled  Boolean   @default(true)
  
  // Rate limiting
  submissionRateLimit Int       @default(5)  // attempts per minute
  
  // Team settings
  maxTeamSize         Int       @default(4)
  
  // Competition timing
  competitionStart    DateTime?
  competitionEnd      DateTime?
  
  updatedAt           DateTime  @updatedAt
}

// ============================================
// AUDIT LOG (Admin Actions)
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  
  // Who did it
  adminId     String
  adminEmail  String
  
  // What action
  action      String   // CREATE_CHALLENGE, DELETE_USER, CHANGE_ROLE, etc.
  entityType  String   // Challenge, User, Team, Announcement, etc.
  entityId    String?
  
  // Details
  details     String?  // JSON with before/after values
  ipAddress   String?
  
  createdAt   DateTime @default(now())
  
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id          String           @id @default(cuid())
  userId      String
  
  type        NotificationType
  title       String
  message     String
  link        String?          // Optional link to navigate to
  
  isRead      Boolean          @default(false)
  
  createdAt   DateTime         @default(now())
  
  @@index([userId, isRead])
  @@index([createdAt])
}

enum NotificationType {
  ACHIEVEMENT_EARNED
  TEAM_JOIN_REQUEST
  TEAM_MEMBER_JOINED
  TEAM_MEMBER_LEFT
  FIRST_BLOOD
  ANNOUNCEMENT
  CHALLENGE_SOLVED
}

// ============================================
// CERTIFICATE MODEL
// ============================================

model Certificate {
  id              String   @id @default(cuid())
  verificationId  String   @unique @default(cuid())
  
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id])
  
  type            CertificateType
  
  // Metadata stored as JSON (rank, points, categories, etc.)
  metadata        Json?
  
  createdAt       DateTime @default(now())
  
  @@index([teamId])
  @@index([verificationId])
}

enum CertificateType {
  COMPETITION
  FIRST_BLOOD
}
